# Copy to .env (git-ignored). Values already set in the environment win.

# --- Canvas ---
# Base URL of your school's Canvas instance, no trailing slash.
CANVAS_BASE_URL=https://school.instructure.com
# Account > Settings > New Access Token. Student tokens expire within 120 days;
# the fetch command fails loudly with a 401 message when it is time to renew.
CANVAS_TOKEN=
# ...or a file holding it:
# CANVAS_TOKEN_FILE=

# --- Google Classroom ---
# OAuth "Desktop app" client JSON from Google Cloud Console. Put the app in
# "In production" publishing status, otherwise the refresh token dies after 7 days.
GOOGLE_CREDENTIALS_FILE=~/.config/schoolwork-check/google-credentials.json
GOOGLE_TOKEN_FILE=~/.config/schoolwork-check/google-token.json

# --- Course calendars kept in a Google Doc ---
# Schedules the teacher keeps in a document instead of the LMS. Comma- or
# newline-separated; each entry is the document's URL (or bare file id),
# optionally followed by |Course Name. Google Docs, Sheets and uploaded
# PDF/DOCX all work, and they use the Google login above — no second consent.
# Each document is exported once per edit and parsed into dated rows by the
# LLM settings below (whatever BRIEF is); with no key the document is passed
# to note whole instead. Rows that ask something of you become tasks; rows
# that are only information go to note's agent inbox.
# A third field sets that document's own re-read interval.
# CALENDAR_DOCS=https://docs.google.com/document/d/1AbC.../edit|Biology|14d, https://docs.google.com/spreadsheets/d/1XyZ.../edit|AP Gov
# How long a parse stays good after the teacher edits the document. A long
# calendar is edited constantly and read rarely, and every read costs model
# calls: once a week is plenty. 0 re-reads on every edit.
# CALENDAR_INTERVAL=7d
# How much of one calendar document is read. Its own setting because a whole
# semester of rows runs well past MAX_EXTRACTED_TEXT, which bounds a brief.
# CALENDAR_MAX_TEXT=524288
# Reading a schedule streams back far more output than a brief does, and free
# models are slow at it. Point calendars at a faster model without changing
# who writes the briefs. Default: LLM_MODEL.
# CALENDAR_MODEL=
# Read LMS materials whose title says "calendar" (a posted course calendar,
# a unit calendar) into dated rows too, instead of passing on a wall of text.
# CALENDAR_MATERIALS=true
# Ask the model whether a calendar row is work Canvas or Classroom already
# lists under a different name, and drop the row when it is.
# CALENDAR_DEDUP=true

# --- Shared Google Calendars (meetings, events) ---
# Comma- or newline-separated, each optionally followed by |Label. Paste
# whichever address Calendar's "Integrate calendar" panel gave you:
#   a published .ics URL  -> read directly, no login, no scope, no Cloud project
#   a calendar id / CalDAV -> read through the API, needs google-login rerun
# Events go to note's calendar (one entry per sitting, kind "busy"), not to
# the task list. Label also names events a free/busy feed publishes as "Busy".
# GOOGLE_CALENDARS=https://calendar.google.com/calendar/ical/c_0123...%40group.calendar.google.com/public/basic.ics|Club Meeting

# --- Brief: who writes the per-task summary / steps / estimate ---
# local = the LLM settings below, called from here
# note  = (default) push hands each new or changed task to note's own agent
#         (POST /api/tasks/{id}/agent); it owns description, duration and steps
#         and drops non-homework. Needs note at f037276 or later.
# off   = no brief
# BRIEF=note
# NOTE_MAX_BRIEFS=20             # note agent calls per push (briefs + inbox); sequential, 5-30 s each
# NOTE_CALENDAR=true             # send events to note's calendar instead of its task list
# NOTE_MAX_CALENDAR=60           # of note's 100 calendar entries, how many this tool may occupy
# NOTE_CALENDAR_QUIET=false      # true = imported meetings hold note's notifications while they run

# --- Local LLM brief (BRIEF=local) ---
# Any OpenAI-compatible endpoint. The key is read from LLM_API_KEY, else from
# LLM_API_KEY_FILE. No key = no brief; everything else still works.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=deepseek/deepseek-v4-flash
# LLM_API_KEY_FILE=~/.config/schoolwork-check/llm-api-key
# LLM_MAX_CALLS=60               # per run; cached tasks cost nothing, the rest wait for the next run
# LLM_CACHE_FILE=~/.local/state/schoolwork-check/enrich-cache.json
# ENRICH=true

# --- Behaviour ---
# SOURCES=canvas,classroom,gdoc,gcal  # default: every configured source
# EXTRACT_ATTACHMENTS=true       # download PDFs/DOCX/Google Docs and extract text
# FILE_CACHE_FILE=~/.local/state/schoolwork-check/attachments.json  # extracted text by file version; unchanged files are not re-downloaded
# MAX_ATTACHMENT_BYTES=20971520  # skip files larger than 20 MiB
# MAX_EXTRACTED_TEXT=65536       # cap extracted text per attachment (bytes)
# PAST_DAYS=30                   # include tasks due up to N days ago
# FUTURE_DAYS=120                # include tasks due up to N days ahead

# --- note (downstream sink) ---
# Base URL of your note server and a bearer token minted under Settings > API tokens.
# NOTE_BASE_URL=http://127.0.0.1:3271
NOTE_TOKEN=
# ...or a file holding it:
# NOTE_TOKEN_FILE=
